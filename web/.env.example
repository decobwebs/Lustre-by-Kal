# Copy to .env.local for development. Set the same values in your host for production.
# `npm run check:launch` tells you what is still missing.

# Live address of the site (used for link previews, sitemap and emails)
NEXT_PUBLIC_SITE_URL=https://lustrebykal.com

# Kal's WhatsApp number, international format, digits only. Leave empty to hide WhatsApp buttons.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Shown on the site; orders and enquiries go to ORDERS_INBOX (falls back to this)
NEXT_PUBLIC_CONTACT_EMAIL=admin@lustrebykal.com
ORDERS_INBOX=admin@lustrebykal.com

# Email sending (https://resend.com). The sender's domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Lustre by Kal <orders@lustrebykal.com>"

# Social handles without @ (hidden until set)
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_FACEBOOK=
NEXT_PUBLIC_TIKTOK=
